# ==============================================================================
#  ⚡ APP DATABASE — TEMPLATE KONFIGURASI ENVIRONMENT (.env)
# ==============================================================================
#  Petunjuk:
#  1. Salin file ini menjadi ".env" di folder utama (root) aplikasi:
#     cp .env.example .env
#  2. Pilih salah satu opsi DATABASE di bawah ini sesuai kebutuhan Anda:
#     - OPSI A: Otomatis (Zero-Config) -> Tidak perlu isi apapun, langsung jalan!
#     - OPSI B: Supabase / PostgreSQL  -> Cukup tempel URL Supabase Anda.
#     - OPSI C: MySQL (cPanel Hosting) -> Isi detail database MySQL hosting Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI DATABASE PENGGUNA (PILIH SALAH SATU OPSI)
# ------------------------------------------------------------------------------

# --- OPSI A: OTOMATIS / ZERO-CONFIG (Sangat Direkomendasikan jika bingung) ---
# Jika DATABASE_URL dan MySQL dibiarkan kosong, aplikasi OTOMATIS membuat database
# lokal (users_data.db) beserta seluruh tabel pengguna tanpa perlu pengaturan apapun!
# DB_TYPE=sqlite

# --- OPSI B: SUPABASE / POSTGRESQL (Paling Mudah untuk Cloud Database) ---
# Jika Anda membuat database di Supabase (https://supabase.com):
# 1. Buka Supabase -> Project Settings -> Database -> Connection string (URI)
# 2. Tempel URL tersebut di bawah ini (ganti [YOUR-PASSWORD] dengan password Anda):
#    (SSL otomatis aktif dan seluruh tabel akan dibuat otomatis oleh aplikasi)
#
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# atau menggunakan connection pooler Supabase (port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- OPSI C: MYSQL (cPanel / Shared Hosting / phpMyAdmin) ---
# Jika menggunakan database MySQL cPanel, buat database & user di cPanel -> MySQL Databases,
# lalu aktifkan baris berikut:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=namauser_appdatabase
# DB_USER=namauser_dbuser
# DB_PASSWORD=password_database_anda
# DB_SSL=false

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. KEAMANAN SIBER & ENKRIPSI KREDENSIAL
# ------------------------------------------------------------------------------
# Ganti dengan string acak rahasia minimal 32 karakter demi keamanan server hosting:
JWT_SECRET=app_database_jwt_secret_change_me_to_random_32_chars_min!
JWT_EXPIRES_IN=7d

# Kunci Enkripsi Master AES-256-GCM (mengamankan password database eksternal user)
ENCRYPTION_SECRET=app_database_aes256_master_key_32chars_random_sec!

# Domain CORS yang diizinkan (opsional, pisahkan koma jika lebih dari satu)
# Jika tidak diisi, backend melayani origin yang sama secara otomatis.
# CORS_ORIGIN=https://namadomainanda.com

# ------------------------------------------------------------------------------
# 4. PENGIRIMAN EMAIL KODE VERIFIKASI OTP (OPSIONAL)
# ------------------------------------------------------------------------------
# Catatan: Jika tidak diisi, aplikasi tetap berjalan normal.
# Di mode development, kode OTP akan ditampilkan di terminal server.

# --- Menggunakan Akun Google (Gmail App Password) ---
# 1. Aktifkan 2-Step Verification di akun Google Anda
# 2. Buka https://myaccount.google.com/apppasswords dan buat App Password (16 huruf)
# GMAIL_USER=email.anda@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# --- Atau Menggunakan Custom SMTP Hosting / Webmail ---
# SMTP_HOST=mail.namadomainanda.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@namadomainanda.com
# SMTP_PASS=password_email_hosting
# MAIL_FROM=no-reply@namadomainanda.com

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (OPSIONAL)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxxxx-yyyyyyyy.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=xxxxxx-yyyyyyyy.apps.googleusercontent.com
